<div class="card-text font-weight-light">
  {% for content in data[1] %}
    <div class="mb-3">
      <h6 class="title font-weight-bold mb-1">
        <a href="#" style="text-decoration: none; pointer-events: none; cursor: default;">{{ content.name }}:</a>
      </h6>
      <p class="mb-0" style="font-size: 0.95rem">
        {% for item in content.keywords %}
          {{ item }}{% unless forloop.last %}, {% endunless %}
        {% endfor %}
      </p>
    </div>
  {% endfor %}
</div>
